# Server Port & Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection
# Replace with your local or RDS PostgreSQL credentials
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusfind
# Alternatively individual fields:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusfind
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Authentication Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# AWS S3 Storage Integration (Prepared for cloud storage)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=campusfind-uploads-bucket
# Note: In production on EC2, use IAM Instance Roles instead of hardcoded access keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
